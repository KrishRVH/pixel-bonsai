#!/usr/bin/env bash
#MISE description="Build archives for every platform from main and publish them as a GitHub release"
#USAGE arg "<version>" help="The release tag, vMAJOR.MINOR.PATCH"
set -euo pipefail

version="${usage_version:-${1:-}}"
if ! [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "usage: mise run release vMAJOR.MINOR.PATCH" >&2
  exit 2
fi
for tool in gh zip; do
  command -v "$tool" >/dev/null || { echo "release needs $tool" >&2; exit 1; }
done
[ "$(git branch --show-current)" = main ] || { echo "release from main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "commit or stash changes first" >&2; exit 1; }
git fetch --quiet origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "push main first: the release tags what origin has" >&2; exit 1; }
if git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
  echo "$version already exists" >&2
  exit 1
fi

mise run standards:check

out="artifacts/release/$version"
rm -rf "$out"
mkdir -p "$out"
stage="$(mktemp -d)"

# The tag goes on before the build, so Go stamps the version into the binaries. It comes off again unless the
# release is published.
git tag -a "$version" -m "$version"
published=false
trap 'rm -rf "$stage"; [ "$published" = true ] || git tag -d "$version" >/dev/null' EXIT
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do
  goos="${target%/*}"
  goarch="${target#*/}"
  name="pixel-bonsai-$version-$goos-$goarch"
  exe=pixel-bonsai
  [ "$goos" = windows ] && exe=pixel-bonsai.exe
  mkdir -p "$stage/$name"
  CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build -trimpath -ldflags="-s -w" -o "$stage/$name/$exe" .
  cp README.md LICENSE "$stage/$name/"
  if [ "$goos" = windows ]; then
    (cd "$stage" && zip -qr - "$name") >"$out/$name.zip"
  else
    tar -C "$stage" -czf "$out/$name.tar.gz" "$name"
  fi
done
(cd "$out" && sha256sum -- *.tar.gz *.zip >SHA256SUMS)

git push origin "$version"
published=true
gh release create "$version" "$out"/* --verify-tag --title "$version" --generate-notes
